# Copy to .env and edit. docker compose reads it automatically.

# Domain pointing (DNS A record) at this server. Caddy gets HTTPS for it.
CC_DOMAIN=collage.example.com

# 1 = anyone can register, 0 = closed (create accounts with the admin CLI)
CC_ALLOW_SIGNUP=1
# Optional: if set, registration requires this invite code
CC_INVITE_CODE=
# Optional: maximum number of accounts, 0 = unlimited
CC_MAX_USERS=0

# Storage per account (MB) and largest single image / font upload (MB)
CC_USER_QUOTA_MB=500
CC_MAX_UPLOAD_MB=40

# Days a login stays valid without use
CC_SESSION_DAYS=30
